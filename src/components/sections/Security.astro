---
import { Image } from 'astro:assets';
import glasfaser from '../../assets/images/glasfaser.jpg';

const points = [
	{
		title: 'Datenresidenz in der EU',
		body: 'Alle Workloads laufen in eu-central-1. Ihre Daten verlassen die EU nicht.',
	},
	{
		title: 'Verschlüsselung durchgängig',
		body: 'At rest und in transit, für jede Komponente der Pipeline — ohne Ausnahme.',
	},
	{
		title: 'Rollenbasierte Zugriffskontrolle',
		body: 'Jeder Agent und jeder Mensch erhält genau die Rechte, die seine Rolle braucht.',
	},
	{
		title: 'Validator als Kontrollinstanz',
		body: 'Ergebnisse verlassen die Pipeline erst nach unabhängiger Prüfung durch den Validator-Agenten.',
	},
	{
		title: 'Vollständiges Audit-Log',
		body: 'Jeder Schritt jedes Agenten ist protokolliert und im Nachhinein nachvollziehbar.',
	},
	{
		title: 'Nach DSGVO-Grundsätzen entwickelt',
		body: 'Datensparsamkeit und Zweckbindung sind Teil der Architektur, nicht nachträglich aufgesetzt.',
	},
];
---

<section id="sicherheit" class="border-t border-border/60 py-24 md:py-32">
	<div class="mx-auto max-w-6xl px-6">
		<div class="max-w-xl">
			<p class="font-mono text-[11px] tracking-[0.14em] text-signal-green uppercase">Sicherheit & Compliance</p>
			<h2 class="mt-3 text-3xl font-medium md:text-4xl">Vertrauen ist Architektur, keine Behauptung</h2>
		</div>

		<div class="mt-12 overflow-hidden rounded-xl border border-border/60">
			<Image
				src={glasfaser}
				alt="Leuchtende Glasfaserleitungen als Sinnbild für gesicherte Datenverbindungen"
				widths={[768, 1280, 1920]}
				sizes="(min-width: 1152px) 1104px, 100vw"
				class="aspect-[21/9] h-auto w-full object-cover"
			/>
		</div>

		<div class="mt-14 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
			{points.map((p) => (
				<div>
					<span class="block h-px w-8 bg-signal-green"></span>
					<h3 class="mt-4 font-heading text-base font-medium">{p.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{p.body}</p>
				</div>
			))}
		</div>
	</div>
</section>
