---
/**
 * Ablauf als nummerierte Stufen auf einer Haarlinie, ein Signal läuft die Linie entlang.
 * Mobil senkrecht, ab 900px waagrecht. Ohne Animation bei reduzierter Bewegung.
 */
interface Props {
	nodes: string[];
	label?: string;
	/** immer senkrecht (für schmale Spalten) */
	vertical?: boolean;
}
const { nodes, label, vertical = false } = Astro.props;
---

<div class:list={['flow', vertical && 'flow--v']}>
	{label && <p class="flow__label">{label}</p>}
	<div class="flow__track">
		<span class="flow__rail" aria-hidden="true"><i></i></span>
		<ol class="flow__list" style={`--n: ${nodes.length}`}>
			{nodes.map((n, i) => (
				<li>
					<span class="flow__dot" aria-hidden="true"></span>
					<span class="flow__no">{String(i + 1).padStart(2, '0')}</span>
					<span class="flow__name">{n}</span>
				</li>
			))}
		</ol>
	</div>
</div>

<style>
	.flow__label { margin: 0 0 18px; font-family: var(--cp-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-foreground); }
	.flow__track { position: relative; }
	.flow__list { display: grid; gap: 18px; margin: 0; padding: 0 0 0 26px; list-style: none; }
	.flow__rail { position: absolute; left: 3.5px; top: 6px; bottom: 6px; width: 1px; background: var(--rule); overflow: hidden; }
	.flow__rail i { position: absolute; left: 0; top: 0; width: 1px; height: 18%; background: linear-gradient(to bottom, transparent, var(--signal-cyan), transparent); animation: flow-y 3.2s linear infinite; }
	.flow__list li { position: relative; display: flex; align-items: baseline; gap: 12px; }
	.flow__dot { position: absolute; left: -26px; top: 5px; width: 8px; height: 8px; background: var(--background); border: 1px solid var(--primary); }
	.flow__list li:last-child .flow__dot { background: var(--primary); }
	.flow__no { flex: none; font-family: var(--cp-mono); font-size: 11px; color: var(--signal-ink); letter-spacing: 0.1em; }
	.flow__name { font-size: 15px; color: var(--foreground); }

	@media (min-width: 900px) {
		.flow:not(.flow--v) .flow__list { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 16px; padding: 22px 0 0; }
		.flow:not(.flow--v) .flow__rail { left: 0; right: 0; top: 3.5px; bottom: auto; width: auto; height: 1px; }
		.flow:not(.flow--v) .flow__rail i { width: 14%; height: 1px; background: linear-gradient(to right, transparent, var(--signal-cyan), transparent); animation-name: flow-x; }
		.flow:not(.flow--v) .flow__list li { flex-direction: column; gap: 6px; }
		.flow:not(.flow--v) .flow__dot { left: 0; top: -22px; }
		.flow:not(.flow--v) .flow__name { font-size: 14px; line-height: 1.4; }
	}
	@keyframes flow-y { from { transform: translateY(-100%); } to { transform: translateY(560%); } }
	@keyframes flow-x { from { transform: translateX(-100%); } to { transform: translateX(720%); } }
	@media (prefers-reduced-motion: reduce) { .flow__rail i { display: none; } }
</style>
