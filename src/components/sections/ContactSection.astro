---
import ContactSurvey from '../ContactSurvey.jsx';
---

<section id="kontakt" class="relative overflow-hidden border-t border-border/60 py-24 md:py-32">
	<div
		class="pointer-events-none absolute top-0 left-1/2 h-[420px] w-[900px] -translate-x-1/2 rounded-full bg-signal-violet/10 blur-[140px]"
		aria-hidden="true"
	></div>

	<div class="relative mx-auto max-w-6xl px-6">
		<div class="mx-auto max-w-lg text-center" data-reveal>
			<p class="font-mono text-[11px] tracking-[0.14em] text-signal-violet uppercase">Kontakt</p>
			<h2 class="mt-3 text-3xl font-medium md:text-4xl">Sagen Sie uns, wo es klemmt</h2>
			<p class="mt-4 text-muted-foreground">Drei kurze Fragen, dann haben Sie uns direkt in Ihrem Postfach.</p>
		</div>

		<div class="mt-12" data-reveal>
			<ContactSurvey client:visible />
		</div>
	</div>
</section>
