---
import SectionHead from '@/components/SectionHead.astro';
import ContactSurvey from '../ContactSurvey.jsx';
---

<section id="kontakt" class="cp-sec">
	<div class="cp-wrap">
		<SectionHead no="07" label="Kontakt" title="Sagen Sie uns, wo es klemmt" lead="Drei kurze Fragen, dann haben Sie uns direkt in Ihrem Postfach." />
		<div class="grid lg:grid-cols-12">
			<div class="cp-rise lg:col-span-7 lg:col-start-4">
				<ContactSurvey client:visible />
			</div>
		</div>
	</div>
</section>
