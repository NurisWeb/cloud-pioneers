---
import { Image } from 'astro:assets';
import SectionHead from '@/components/SectionHead.astro';
import serverreihe from '../../assets/images/serverreihe.jpg';

const columns = [
	{
		title: 'Cloud-Plattformen',
		items: [
			'AWS: Bedrock Agents, ECS, SQS, RDS, Vector Store',
			'Azure: AI Foundry Agents, AKS, Service Bus',
			'IAM- und Netzwerk-Hardening auf beiden Plattformen',
			'Multi-Cloud- und Hybrid-Deployments',
		],
	},
	{
		title: 'Agentic AI',
		items: [
			'Multi-Agent-Orchestrierung, nicht nur Einzel-Prompts',
			'Agents-in-the-Loop mit definierten Eskalationspfaden',
			'Tool-Use & Function-Calling gegen echte Systeme',
			'Validator-Pattern statt blindem Vertrauen ins Modell',
		],
	},
	{
		title: 'Wissensrepräsentation',
		items: [
			'Embeddings & Vektorsuche für semantischen Kontext',
			'Knowledge-Graphen für Beziehungen, die Vektoren verlieren',
			'Hybrid-Retrieval: Graph + Vektor + klassische Filter',
			'Deduplizierung und Konsistenzprüfung im Datenraum',
		],
	},
	{
		title: 'Observability & Harness',
		items: [
			'Vollständiges Logging jedes Agentenschritts',
			'Reproduzierbare Evals über einen festen Test-Harness',
			'Kein Blackbox-Verhalten — jede Entscheidung ist auditierbar',
			'Rollback- und Kill-Switches auf Agenten-Ebene',
		],
	},
];

---

<section id="expertise" class="cp-sec">
	<div class="cp-wrap">
		<SectionHead
			no="05"
			label="Expertise"
			title="Zwei Ebenen, ein Team"
			lead="Cloud-Infrastruktur und AI Engineering laufen bei uns nicht in getrennten Teams. Wer die Agenten baut, kennt auch das Netzwerk, in dem sie laufen."
		/>

		<div class="cp-media mb-5">
			<Image
				src={serverreihe}
				alt="Serverreihe in einem Rechenzentrum mit blau leuchtenden Statusanzeigen"
				widths={[640, 960, 1280, 1920]}
				sizes="(min-width: 1152px) 1104px, 100vw"
				class="aspect-[16/9] h-auto w-full object-cover md:aspect-[21/8]"
			/>
		</div>

		<div class="cp-grid grid-cols-1 sm:grid-cols-2">
			{columns.map((col, i) => (
				<div class="cp-cell">
					<span class="cp-cell__no">{String(i + 1).padStart(2, '0')}</span>
					<h3>{col.title}</h3>
					<ul class="cp-dash">
						{col.items.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			))}
		</div>
	</div>
</section>
