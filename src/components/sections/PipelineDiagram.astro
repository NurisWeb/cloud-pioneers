---
interface Props {
	nodes: string[];
	color?: string;
}

const { nodes, color = '#5B8DEF' } = Astro.props;
const gap = 100 / (nodes.length - 1);
---

<svg viewBox="0 0 100 34" class="w-full" preserveAspectRatio="none" aria-hidden="true">
	<line x1="4" y1="17" x2="96" y2="17" stroke={color} stroke-opacity="0.25" stroke-width="0.6" />
	<line
		x1="4"
		y1="17"
		x2="96"
		y2="17"
		stroke={color}
		stroke-width="0.6"
		stroke-dasharray="3 4"
		class="pipeline-flow"
	/>
	{nodes.map((_, i) => {
		const x = 4 + gap * i * 0.92;
		return (
			<g>
				<circle cx={x} cy="17" r="3.4" fill="var(--card)" stroke={color} stroke-width="0.8" />
				<circle cx={x} cy="17" r="1.3" fill={color} class="pipeline-pulse" style={{ animationDelay: `${i * 0.4}s` }} />
			</g>
		);
	})}
</svg>

<div class="mt-3 grid gap-2" style={`grid-template-columns: repeat(${nodes.length}, 1fr)`}>
	{nodes.map((label) => (
		<span class="text-center font-mono text-[10px] tracking-wide text-muted-foreground uppercase">{label}</span>
	))}
</div>

<style>
	.pipeline-flow {
		stroke-dashoffset: 0;
		animation: pipeline-dash 2.4s linear infinite;
	}
	.pipeline-pulse {
		animation: pipeline-pulse 2s ease-in-out infinite;
	}
	@keyframes pipeline-dash {
		to {
			stroke-dashoffset: -28;
		}
	}
	@keyframes pipeline-pulse {
		0%, 100% { opacity: 0.4; r: 1.1; }
		50% { opacity: 1; r: 1.8; }
	}
	@media (prefers-reduced-motion: reduce) {
		.pipeline-flow, .pipeline-pulse { animation: none; }
	}
</style>
