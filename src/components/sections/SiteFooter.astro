---
const year = new Date().getFullYear();
---

<footer class="border-t border-border/60">
	<div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12 md:flex-row md:items-center md:justify-between">
		<a href="/" aria-label="Cloud Pioneers – Startseite">
			<img src="/logo-light.svg" alt="Cloud Pioneers" width="120" height="28" class="h-7 w-auto" loading="lazy" />
		</a>
		<nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted-foreground">
			<a href="/#ueber-uns" class="hover:text-foreground">Über uns</a>
			<a href="/#ablauf" class="hover:text-foreground">Ablauf</a>
			<a href="/#expertise" class="hover:text-foreground">Expertise</a>
			<a href="/#sicherheit" class="hover:text-foreground">Sicherheit</a>
			<a href="/#kontakt" class="hover:text-foreground">Kontakt</a>
			<a href="/impressum" class="hover:text-foreground">Impressum</a>
			<a href="/datenschutz" class="hover:text-foreground">Datenschutz</a>
		</nav>
		<p class="font-mono text-xs text-muted-foreground">© {year} Cloud Pioneers</p>
	</div>
</footer>
