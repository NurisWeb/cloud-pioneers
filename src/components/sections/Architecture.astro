---
import SectionHead from '@/components/SectionHead.astro';

const panels = [
	{ label: 'Infrastruktur', items: ['VPC in eu-central-1', 'ECS-Tasks, autoskaliert', 'SQS für Ingest-Queues', 'RDS + Vector Store'] },
	{ label: 'Datenfluss', items: ['Chunking & Embedding', '1536-dim Vektorraum', 'Dedup gegen Vector Store', 'Latenz-Monitoring (p95)'] },
	{ label: 'Agenten', items: ['1 Orchestrator, 5 Spezialisten', 'Parallele Ausführung', 'Unabhängiger Validator', 'Vollständiges Audit-Log'] },
];
---

<section id="architektur" class="cp-sec cp-sec--alt overflow-hidden">
	<div class="arch-grid" aria-hidden="true"></div>
	<div class="cp-wrap relative">
		<SectionHead no="02" label="Architektur" title="Unter der Haube" lead="Keine Blackbox. Jede Schicht ist beobachtbar, jede Entscheidung nachvollziehbar." />

		<div class="cp-grid grid-cols-1 md:grid-cols-3">
			{panels.map((p, i) => (
				<div class="cp-cell">
					<div class="flex items-center justify-between">
						<span class="cp-tag">{p.label}</span>
						<span class="cp-cell__no">L{i + 1}</span>
					</div>
					<ul class="cp-dash cp-dash--mono mt-6">
						{p.items.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	/* technisches Raster im Hintergrund, zu den Rändern ausgeblendet */
	.arch-grid {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image: linear-gradient(to right, rgb(245 246 247 / 0.05) 1px, transparent 1px), linear-gradient(to bottom, rgb(245 246 247 / 0.05) 1px, transparent 1px);
		background-size: 72px 72px;
		mask-image: radial-gradient(ellipse 60% 70% at 85% 10%, #000 10%, transparent 70%);
	}
</style>
