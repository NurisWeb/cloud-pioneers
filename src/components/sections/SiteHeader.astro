---
import { Button } from '@/components/ui/button';
---

<header class="sticky top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur-md">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
		<a href="/" class="flex items-center gap-2 font-heading text-[15px] font-medium">
			<span class="relative flex h-[18px] w-[18px] items-center justify-center rounded-[5px] border border-signal-cyan">
				<span class="h-2 w-2 rounded-[2px] bg-signal-cyan"></span>
			</span>
			Cloud Pioneers
		</a>
		<nav class="hidden items-center gap-8 text-sm text-muted-foreground lg:flex">
			<a href="#ueber-uns" class="transition-colors hover:text-foreground">Über uns</a>
			<a href="#ablauf" class="transition-colors hover:text-foreground">Ablauf</a>
			<a href="#expertise" class="transition-colors hover:text-foreground">Expertise</a>
			<a href="#sicherheit" class="transition-colors hover:text-foreground">Sicherheit</a>
			<a href="#kontakt" class="transition-colors hover:text-foreground">Kontakt</a>
		</nav>
		<Button size="sm" asChild>
			<a href="#kontakt">Gespräch vereinbaren</a>
		</Button>
	</div>
</header>
