---
/**
 * Einziger Header der Seite: fest oben, über der Hero transparent,
 * nach dem ersten Scrollen mit dunklem Hintergrund (data-scrolled).
 */
import LinkButton from '@/components/ui/LinkButton.astro';
import { NAV as links, CONTACT_CTA } from '@/data/navigation';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => !href.includes('#') && current === href;
---

<header
	id="site-header"
	class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300 data-[scrolled]:border-border/60 data-[scrolled]:bg-background/85 data-[scrolled]:backdrop-blur-md"
>
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-6">
		<a href="/" class="shrink-0" aria-label="Cloud Pioneers – Startseite">
			<img src="/logo-light.svg" alt="Cloud Pioneers" width="137" height="32" class="h-7 w-auto md:h-8" />
		</a>

		<nav aria-label="Hauptnavigation" class="hidden items-center gap-8 text-sm text-muted-foreground lg:flex">
			{links.map((l) => (
				<a
					href={l.href}
					aria-current={isActive(l.href) ? 'page' : undefined}
					class:list={['transition-colors hover:text-foreground', isActive(l.href) && 'text-foreground']}
				>
					{l.label}
				</a>
			))}
		</nav>

		<div class="flex items-center gap-3">
			<div class="hidden sm:block"><LinkButton href={CONTACT_CTA.href}>{CONTACT_CTA.label}</LinkButton></div>

			<!-- Mobil: Menü ohne JavaScript -->
			<details class="group lg:hidden">
				<summary
					class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg border border-border text-foreground [&::-webkit-details-marker]:hidden"
					aria-label="Menü"
				>
					<svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
						<path class="group-open:hidden" d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
						<path class="hidden group-open:block" d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
					</svg>
				</summary>
				<nav aria-label="Mobile Navigation" class="absolute inset-x-0 top-16 border-b border-border/60 bg-background px-6 pt-2 pb-6">
					<ul class="divide-y divide-border/60">
						{links.map((l) => (
							<li><a href={l.href} class="block py-3 text-base text-foreground">{l.label}</a></li>
						))}
					</ul>
					<LinkButton href={CONTACT_CTA.href} size="lg" class="mt-4 w-full">{CONTACT_CTA.label}</LinkButton>
				</nav>
			</details>
		</div>
	</div>
</header>

<script>
	const header = document.getElementById('site-header');
	const update = () => header?.toggleAttribute('data-scrolled', window.scrollY > 24);
	update();
	window.addEventListener('scroll', update, { passive: true });
	// Mobilmenü nach Klick auf einen Link schließen
	header?.querySelectorAll('details a').forEach((a) =>
		a.addEventListener('click', () => header.querySelector('details')?.removeAttribute('open'))
	);
</script>
