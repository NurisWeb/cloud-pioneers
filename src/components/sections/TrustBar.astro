---
const items = [
	'EU-Hosting (Frankfurt)',
	'Verschlüsselung at rest & in transit',
	'Audit-Log pro Agentenschritt',
	'Rollenbasierte Zugriffskontrolle',
];
---

<section class="border-b border-border/60 bg-card/40">
	<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center divide-y-0 gap-y-3 px-6 py-5 text-center">
		{items.map((item, i) => (
			<span class:list={["flex items-center font-mono text-[11px] tracking-wider text-muted-foreground uppercase px-5", i > 0 && "border-l border-border/60"]}>
				{item}
			</span>
		))}
	</div>
</section>
