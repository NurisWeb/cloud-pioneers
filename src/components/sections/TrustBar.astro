---
// Kennzahlen-Leiste wie ein Datenblatt: Kategorie in Mono, Aussage darunter.
const items = [
	{ k: 'Hosting', v: 'EU-Rechenzentrum Frankfurt' },
	{ k: 'Verschlüsselung', v: 'At rest & in transit' },
	{ k: 'Nachvollziehbarkeit', v: 'Audit-Log pro Agentenschritt' },
	{ k: 'Zugriff', v: 'Rollenbasierte Kontrolle' },
];
---

<section class="border-b border-[var(--line)]" aria-label="Grundsätze">
	<dl class="cp-wrap grid grid-cols-2 md:grid-cols-4">
		{items.map((item, i) => (
			<div class:list={['py-5 pr-4', i % 2 === 1 && 'border-l border-[var(--line)] pl-4', i > 1 && 'border-t border-[var(--line)] md:border-t-0', i === 2 && 'md:border-l md:pl-4']}>
				<dt class="font-mono text-[10.5px] tracking-[0.14em] text-muted-foreground uppercase">{item.k}</dt>
				<dd class="mt-1.5 text-sm text-foreground">{item.v}</dd>
			</div>
		))}
	</dl>
</section>
