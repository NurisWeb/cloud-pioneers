---
import SectionHead from '@/components/SectionHead.astro';

const steps = [
	{ title: 'Eingang', body: 'Eine Anfrage, ein Dokument oder ein Event trifft ein — über API, Postfach oder bestehendes Tool.' },
	{ title: 'Orchestrierung', body: 'Der Orchestrator-Agent zerlegt die Aufgabe und verteilt sie an die passenden Spezialisten.' },
	{ title: 'Parallele Agenten', body: 'RAG-Retrieval, Embedding, Dokumenten-Analyse und Deduplizierung laufen gleichzeitig, nicht nacheinander.' },
	{ title: 'Validierung', body: 'Ein unabhängiger Validator-Agent prüft jedes Ergebnis gegen feste Kriterien, bevor es zurückkommt.' },
];
---

<section id="ablauf" class="cp-sec">
	<div class="cp-wrap">
		<SectionHead
			no="01"
			label="Ablauf"
			title="Vom Auftrag zum geprüften Ergebnis"
			lead="Kein Chatbot, der rät. Eine Pipeline aus spezialisierten Agenten, die in fester Reihenfolge zusammenarbeiten — und ein Validator, der am Ende gegenzeichnet."
		/>

		<ol class="cp-grid steps grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
			{steps.map((s, i) => (
				<li class="cp-cell" style={`--i: ${i}`}>
					<span class="steps__bar" aria-hidden="true"></span>
					<span class="cp-cell__no">{String(i + 1).padStart(2, '0')} / 04</span>
					<h3>{s.title}</h3>
					<p>{s.body}</p>
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.steps { margin: 0; padding: 0; list-style: none; }
	/* Fortschritt: jede Stufe füllt ihre Kante nacheinander, gekoppelt an das Scrollen */
	.steps__bar { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--rule); }
	.steps__bar::after { content: ''; position: absolute; inset: 0; background: var(--primary); transform-origin: 0 50%; }
	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.steps__bar::after {
				animation: steps-fill linear both;
				animation-timeline: view();
				animation-range: entry calc(30% + var(--i) * 12%) entry calc(52% + var(--i) * 12%);
			}
		}
	}
	@keyframes steps-fill { from { transform: scaleX(0); } }
</style>
