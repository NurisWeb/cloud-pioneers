---
// TODO: Fotos ergänzen, Kurzprofile vom Team bestätigen lassen.
const team = [
	{
		name: 'Ömer Türker',
		role: 'Geschäftsführer & Tech Lead',
		bio: 'Verantwortet die technische Gesamtarchitektur und jedes Projekt vom Kickoff bis zum Go-live — und ist erster Ansprechpartner für Entscheider.',
		tags: ['Architektur', 'Delivery', 'Cloud'],
		signal: 'cyan',
	},
	{
		name: 'Marcel Könen',
		role: 'Security & Infrastructure Expert',
		bio: 'Härtet Netzwerke, Identitäten und Plattformen. Sorgt dafür, dass Sicherheitsanforderungen von Beginn an Teil der Architektur sind.',
		tags: ['Security', 'IAM', 'Infrastruktur'],
		signal: 'green',
	},
	{
		name: 'Michelle Leuter',
		role: 'HR & Product Manager',
		bio: 'Übersetzt fachliche Anforderungen in klare Produktziele und verantwortet Teamaufbau und Recruiting.',
		tags: ['Produktmanagement', 'Anforderungen', 'HR'],
		signal: 'violet',
	},
	{
		name: 'Robin Christ',
		role: 'System Administrator & AI Developer',
		bio: 'Betreibt und überwacht die Systeme, auf denen unsere Lösungen laufen, und entwickelt KI-Komponenten für den produktiven Einsatz.',
		tags: ['Betrieb', 'Monitoring', 'AI'],
		signal: 'cyan',
	},
	{
		name: 'Gökay Şahin',
		role: 'AI Architect & Full-Stack Engineer',
		bio: 'Konzipiert KI-Architekturen und Multi-Agent-Systeme und setzt sie als produktionsreife Anwendungen um — vom Backend bis zur Oberfläche.',
		tags: ['AI Architecture', 'Agentic AI', 'Full-Stack'],
		signal: 'violet',
	},
];

const dot: Record<string, string> = { cyan: 'bg-signal-cyan', violet: 'bg-signal-violet', green: 'bg-signal-green' };
const ring: Record<string, string> = { cyan: 'border-signal-cyan/50', violet: 'border-signal-violet/50', green: 'border-signal-green/50' };
const glowVar: Record<string, string> = { cyan: '#7DE3F6', violet: '#B9A6FF', green: '#6FE7A0' };
---

<section id="ueber-uns" class="relative overflow-hidden border-t border-border/60 py-24 md:py-32">
	<div
		class="pointer-events-none absolute -top-40 right-[-10%] h-[420px] w-[420px] rounded-full bg-signal-violet/10 blur-[120px]"
		aria-hidden="true"
	></div>

	<div class="relative mx-auto max-w-6xl px-6">
		<div class="max-w-xl" data-reveal>
			<p class="font-mono text-[11px] tracking-[0.14em] text-signal-cyan uppercase">Über uns</p>
			<h2 class="mt-3 text-3xl font-medium md:text-4xl">Das Team hinter Cloud Pioneers</h2>
			<p class="mt-4 text-muted-foreground">
				Feste Ansprechpartner statt wechselnder Berater: Unser Kernteam verantwortet Architektur, Umsetzung
				und Betrieb — vom ersten Gespräch bis zum laufenden System.
			</p>
		</div>

		<div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
			{team.map((person) => (
				<div class="glow-card rounded-xl border border-border/60 bg-card/40 p-6" style={{ '--glow': glowVar[person.signal] }}>
					<div class={`flex h-11 w-11 items-center justify-center rounded-full border ${ring[person.signal]}`}>
						<span class={`h-2.5 w-2.5 rounded-full ${dot[person.signal]}`}></span>
					</div>
					<h3 class="mt-4 font-heading text-lg font-medium">{person.name}</h3>
					<p class="text-sm text-muted-foreground">{person.role}</p>
					<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{person.bio}</p>
					<div class="mt-4 flex flex-wrap gap-1.5">
						{person.tags.map((tag) => (
							<span class="rounded-full border border-border/60 px-2.5 py-1 font-mono text-[10px] tracking-wide text-muted-foreground uppercase">
								{tag}
							</span>
						))}
					</div>
				</div>
			))}
		</div>
	</div>
</section>
